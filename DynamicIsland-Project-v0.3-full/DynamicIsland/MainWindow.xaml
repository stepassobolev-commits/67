<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="270" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource TextFont}">
    <Grid>
        <Border x:Name="RootBorder" Width="200" Height="36" Margin="0,8,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="18" BorderThickness="1" ClipToBounds="True"
                MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F01E1E21" Offset="0"/>
                    <GradientStop Color="#F0121214" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#45FFFFFF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu x:Name="IslandMenu">
                    <MenuItem Header="Закрыть Dynamic Island" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Компактная капсула -->
                <Grid x:Name="CompactPanel" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="PlayingDot" Width="8" Height="8" Fill="#636366"
                             HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="--:--" Foreground="#F2F2F7"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <!-- Раскрытая панель -->
                <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Opacity="0"
                      Width="364" Height="444" Margin="0,18,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Часы и дата -->
                    <Grid Grid.Row="0" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ClockBig" Text="--:--" Foreground="White" FontSize="36" FontWeight="Light"/>
                        <TextBlock x:Name="DateText" Grid.Column="1" Text=" " Foreground="#8E8E93" FontSize="13"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </Grid>

                    <!-- Проигрыватель -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="16" Background="#1FFFFFFF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="10" Background="#2C2C2E" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="♪" Foreground="#636366" FontSize="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrackTitle" Text="Ничего не играет" Foreground="#F2F2F7"
                                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TrackArtist" Text="Запустите музыку в Spotify или другом плеере"
                                               Foreground="#8E8E93" FontSize="12" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click" ToolTip="Назад"/>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                        FontSize="22" Width="48" Margin="10,0" Click="PlayPause_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Далее"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Громкость -->
                    <Grid Grid.Row="2" Margin="6,12,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="#8E8E93"
                                   FontSize="15" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource MacSlider}"
                                Margin="10,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="--%" Foreground="#8E8E93"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Заголовок буфера обмена -->
                    <Grid Grid.Row="3" Margin="4,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Буфер обмена" Foreground="#F2F2F7" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Foreground="#0A84FF" FontSize="11" Margin="8,1,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="LimitButton" Style="{StaticResource TextAction}" Content="Лимит: 5"
                                    Click="Limit_Click" ToolTip="Сколько записей хранить: 5 / 10 / 20"/>
                            <Button x:Name="PauseButton" Style="{StaticResource TextAction}" Content="Пауза"
                                    Click="Pause_Click" ToolTip="Приостановить запись буфера"/>
                            <Button Style="{StaticResource TextAction}" Content="Очистить"
                                    Click="Clear_Click" ToolTip="Удалить все, кроме закреплённых"/>
                        </StackPanel>
                    </Grid>

                    <!-- Список записей -->
                    <Grid Grid.Row="4">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ClipboardItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card" Background="#14FFFFFF" CornerRadius="10"
                                                Margin="0,0,0,6" Padding="11,8,6,8" Cursor="Hand"
                                                MouseLeftButtonUp="ClipboardItem_Click"
                                                ToolTip="Нажмите, чтобы скопировать снова">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Preview}" Foreground="#F2F2F7" FontSize="12"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                                    <TextBlock Text="{Binding TimeText}" Foreground="#8E8E93" FontSize="10"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal"
                                                            Opacity="0" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE718;"
                                                            Width="30" Height="28" FontSize="13"
                                                            Foreground="{Binding PinBrush}" Click="Pin_Click" ToolTip="Закрепить"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                            Width="30" Height="28" FontSize="13"
                                                            Foreground="#8E8E93" Click="Delete_Click" ToolTip="Удалить"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#28FFFFFF"/>
                                                <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyText" Text="Скопируйте текст — он появится здесь"
                                   Foreground="#636366" FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
